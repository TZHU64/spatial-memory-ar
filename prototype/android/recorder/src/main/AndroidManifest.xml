<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.CAMERA" />
 <uses-feature android:name="android.hardware.camera.any" android:required="true" />
 <application android:name=".RecorderApplication" android:label="Walk Recorder"
     android:theme="@style/Theme.WalkRecorder" android:allowBackup="false">
  <meta-data android:name="com.rayneo.mercury.app" android:value="true" />
  <activity android:name=".RecorderActivity" android:exported="true" android:screenOrientation="landscape">
   <intent-filter>
    <action android:name="android.intent.action.MAIN" />
    <category android:name="android.intent.category.LAUNCHER" />
   </intent-filter>
  </activity>
 </application>
</manifest>
